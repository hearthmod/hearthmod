# Copy to .env and edit before `docker compose up`.

# Compose project name (replaces the removed top-level `name:` key).
COMPOSE_PROJECT_NAME=hearthmod

# Address the Hearthstone CLIENT is told to use for the gameserver.
# The lobby relays this to the client, so it must be reachable from the
# player's machine — usually this Docker host's LAN IP (e.g. 192.168.1.50).
GAMESERVER_PUBLIC_IP=127.0.0.1

# Couchbase admin credentials, created on first boot.
COUCHBASE_ADMIN_USER=Administrator
COUCHBASE_ADMIN_PASSWORD=password
